<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>1.2.0.0</Version>
    <Name>MomoTalk</Name>
    <Author>LolipopJ</Author>
    <Punchline>Blue Archive's MomoTalk in Eorzea — [Yuuka] Sen--se--i! I need you to work harder!</Punchline>
    <Description>Bring Blue Archive's iconic MomoTalk into FINAL FANTASY XIV! Crafted for every Sensei in Eorzea, MomoTalk turns your in-game friend /tells, Free Company, Linkshells, Cross-world Linkshells, and Static party chats into a faithful Blue Archive messenger — complete with a draggable floating phone button, the signature bouncy opening splash, grouped chat bubbles, Lodestone avatars, editable friend and group notes, optional AI reply suggestions, and per-character local history. Open with /momotalk or tap the floating MomoTalk icon anytime.</Description>
    <RepoUrl>https://github.com/LolipopJ/ffxiv-momotalk</RepoUrl>
    <Tags>social;chat;tell;linkshell;party;ai;momotalk;bluearchive</Tags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Data/entry.png" LogicalName="FFXIVMomoTalk.Assets.entry.png" />
    <EmbeddedResource Include="../Data/momo-logo.png" LogicalName="FFXIVMomoTalk.Assets.momo-logo.png" />
    <EmbeddedResource Include="../Data/momotalk-cover.png" LogicalName="FFXIVMomoTalk.Assets.momotalk-cover.png" />
    <Content Include="../Data/icon.png" Link="images/icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="NetStone" Version="1.4.1" />
  </ItemGroup>
</Project>
